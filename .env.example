# Google Antigravity SDK settings
ANTIGRAVITY_MODEL=gemini-4-hydrogen
# Required for Gemini API mode (or enable VERTEX_ENABLED=true with GCP_PROJECT_ID)
GEMINI_API_KEY=
VERTEX_ENABLED=false
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Voiceover settings (en-GB-RyanNeural or en-US-AndrewNeural)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=-10%

# YouTube upload settings (private | unlisted | public)
PRIVACY_STATUS=public
YOUTUBE_PRIVACY_STATUS=public
SHORTS_PER_RUN=2
